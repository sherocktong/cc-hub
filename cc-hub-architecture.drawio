<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="&lt;b&gt;cc-hub Architecture&lt;/b&gt;" style="text;html=1;fontSize=18;align=center;" vertex="1" parent="1">
      <mxGeometry x="350" y="20" width="200" height="30" as="geometry"/>
    </mxCell>

    <!-- Entry Point Box -->
    <mxCell id="entry" value="&lt;b&gt;src/index.ts&lt;/b&gt;&lt;br&gt;Commander.js CLI Entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="350" y="70" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- Source Files Group -->
    <mxCell id="srcGroup" value="Source Modules" style="swimlane;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="50" y="150" width="760" height="200" as="geometry"/>
    </mxCell>

    <!-- profiles.ts -->
    <mxCell id="profiles" value="&lt;b&gt;src/profiles.ts&lt;/b&gt;&lt;br&gt;profile CRUD, use, run&lt;br&gt;execClaude() launcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="20" y="40" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- hooks.ts -->
    <mxCell id="hooks" value="&lt;b&gt;src/hooks.ts&lt;/b&gt;&lt;br&gt;hook subcommand&lt;br&gt;settings.json hooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="190" y="40" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- sessions.ts -->
    <mxCell id="sessions" value="&lt;b&gt;src/sessions.ts&lt;/b&gt;&lt;br&gt;session subcommand&lt;br&gt;read JSONL files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="360" y="40" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- provider.ts -->
    <mxCell id="provider" value="&lt;b&gt;src/provider.ts&lt;/b&gt;&lt;br&gt;provider subcommand&lt;br&gt;OpenAI proxy server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="530" y="40" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- config.ts -->
    <mxCell id="config" value="&lt;b&gt;src/config.ts&lt;/b&gt;&lt;br&gt;file paths&lt;br&gt;JSON utilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="105" y="120" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- types.ts -->
    <mxCell id="types" value="&lt;b&gt;src/types.ts&lt;/b&gt;&lt;br&gt;TypeScript interfaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="255" y="120" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- complete.ts -->
    <mxCell id="complete" value="&lt;b&gt;src/complete.ts&lt;/b&gt;&lt;br&gt;shell completion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="srcGroup">
      <mxGeometry x="405" y="120" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- Config Files Group -->
    <mxCell id="configGroup" value="Config Files" style="swimlane;horizontal=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="50" y="380" width="760" height="120" as="geometry"/>
    </mxCell>

    <!-- profiles.json -->
    <mxCell id="profilesJson" value="&lt;b&gt;~/.claude/profiles.json&lt;/b&gt;&lt;br&gt;Profile definitions" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="configGroup">
      <mxGeometry x="60" y="35" width="160" height="60" as="geometry"/>
    </mxCell>

    <!-- settings.json -->
    <mxCell id="settingsJson" value="&lt;b&gt;~/.claude/settings.json&lt;/b&gt;&lt;br&gt;Model, hooks, settings" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="configGroup">
      <mxGeometry x="300" y="35" width="180" height="60" as="geometry"/>
    </mxCell>

    <!-- projects/ -->
    <mxCell id="projectsDir" value="&lt;b&gt;~/.claude/projects/&lt;/b&gt;&lt;br&gt;Session JSONL files" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="configGroup">
      <mxGeometry x="560" y="35" width="160" height="60" as="geometry"/>
    </mxCell>

    <!-- Flow Arrows from entry to modules -->
    <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="entry" target="profiles">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="entry" target="hooks">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="entry" target="sessions">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="entry" target="provider">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- execClaude Flow Box -->
    <mxCell id="flowBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="520" width="460" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="flowLabel" value="execClaude() Launch Flow" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
      <mxGeometry x="210" y="525" width="150" height="20" as="geometry"/>
    </mxCell>

    <!-- Flow steps -->
    <mxCell id="step1" value="1. updateSettingsForProfile()&lt;br&gt;writes model to settings.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#0070c0;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="220" y="550" width="140" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="step2" value="2. Set env vars&lt;br&gt;ANTHROPIC_AUTH_TOKEN&lt;br&gt;ANTHROPIC_BASE_URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#0070c0;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="385" y="550" width="130" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="step3" value="3. For OpenAI profiles:&lt;br&gt;startOpenAIProxy()&lt;br&gt;on random port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f3ff;strokeColor=#0070c0;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="540" y="550" width="110" height="45" as="geometry"/>
    </mxCell>

    <mxCell id="step4" value="4. Launch Claude Code process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ffe6;strokeColor=#009900;fontSize=10;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="340" y="615" width="180" height="35" as="geometry"/>
    </mxCell>

    <!-- Proxy Flow Box -->
    <mxCell id="proxyBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="520" width="130" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="proxyLabel" value="OpenAI Proxy" style="text;html=1;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="55" y="525" width="120" height="20" as="geometry"/>
    </mxCell>

    <mxCell id="proxy1" value="Anthropic&lt;br&gt;Messages API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="65" y="550" width="100" height="35" as="geometry"/>
    </mxCell>

    <mxCell id="proxy2" value="↔ Translate ↔" style="text;html=1;fontSize=9;align=center;" vertex="1" parent="1">
      <mxGeometry x="65" y="585" width="100" height="15" as="geometry"/>
    </mxCell>

    <mxCell id="proxy3" value="OpenAI&lt;br&gt;Chat Completions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1">
      <mxGeometry x="65" y="605" width="100" height="40" as="geometry"/>
    </mxCell>

    <!-- Arrow from profiles to config files -->
    <mxCell id="a1" value="reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="profiles" target="profilesJson">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="80" y="380"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="a2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="profiles" target="settingsJson">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="200" y="360"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="a3" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="sessions" target="projectsDir">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="430" y="360"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Arrow to flow box -->
    <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="profiles" target="flowBox">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="200" y="500"/>
          <mxPoint x="430" y="500"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow connections -->
    <mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="step1" target="step2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="step2" target="step3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="step2" target="step4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="450" y="585"/>
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>